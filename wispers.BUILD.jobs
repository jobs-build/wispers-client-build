# wispers.BUILD.jobs — the real-world Rust build: github.com/s-te-ch/wispers-client.
#
# Applied to the pinned upstream tree by the wrapper BUILD.jobs (buildJobs
# override), so `source` here IS the upstream repo. What upstream needs beyond
# plain cargo — and how each gap is filled hermetically:
#
#   * C/C++ toolchain   — the `boring` crate compiles vendored BoringSSL (C+C++),
#     build.rs compiles libjuice (C, cmake), `ring` compiles asm: Alpine v3.22
#     gcc/g++ apks staged into the sandbox root (they run natively at /usr under
#     the staged /lib/ld-musl loader).
#   * cmake + make      — boring-sys + libjuice: Alpine apks.
#   * libclang          — bindgen (libjuice + boring bindings): clang20-libclang +
#     clang20-headers apks, LIBCLANG_PATH=/usr/lib/llvm20/lib.
#   * protoc            — tonic-build/prost-build (hub/roster/storage protos):
#     protoc apk, PROTOC env.
#   * OpenSSL           — wcadm's reqwest uses native-tls (no vendored openssl in
#     the lock): openssl-dev apk at build time; libssl/libcrypto shipped in
#     $out/lib, found via the $ORIGIN/../lib RUNPATH.
#   * libjuice submodule — github archive tarballs exclude submodules: fetched as
#     its own pinned import and copied to wispers-connect/third_party/libjuice.
#   * Rust ≥1.85 (edition 2024) — the musl-hosted rust 1.96 dist tarball; Alpine
#     gcc is the linker driver, so crt files/libstdc++/libssl resolve natively.
#
# The output binaries are dynamic musl ELFs whose interpreter + RUNPATH point at
# the hostmusl loader's content-addressed store path (a runtime_dep), plus
# $ORIGIN/../lib for the shipped shared libs — `jobs run`/`jobs image` resolve
# both from the materialized closure.

APK_ARCH = {"linux/amd64": "x86_64", "linux/arm64": "aarch64"}

# The libjuice submodule commit pinned by wispers-client (git submodule status).
LIBJUICE_REF = "22145ec3473c73d811417ac9a6aee0de530aaa3f"

RUST_SHA = {
    "x86_64": "545aff63f37dea2fcbd8037b877219fca6fbba97660bdcb8d3a0fc5df5fa9edf",
    "aarch64": "f55a1f02736d9bcd38969a30f2e6bde8184fd36f13e94f773cac068a56407f16",
}

# Alpine v3.22 main pins: (name, version, {arch: sha256-of-apk}) — the full
# dependency closure of: gcc g++ make cmake musl-dev linux-headers openssl-dev
# protoc clang20-libclang clang20-headers busybox musl (computed from APKINDEX;
# same versions on both arches, only the .apk sha256 differs). Build-time only —
# nothing here ends up in the runtime closure; the handful of shared libs the
# binaries need at run time are copied into $out/lib instead.
