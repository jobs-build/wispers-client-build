    ("libssl3", "3.5.7-r0", {"x86_64": "a3c2fa13023e88bf4f8dfe0e8847dcc1e2c1170be99969d761733e92b80dffa8", "aarch64": "8313f54b1bdb54b8ff88fac1e26f2d99bc28853c0fbcecce43f4bd5fdd2fadba"}),
    ("libstdc++", "14.2.0-r6", {"x86_64": "939f7c99898f3e8154207a17f4acbe8bc40437e1bb1b43f5525620ca9e452a2e", "aarch64": "0d2f054057a4f932e985a129eccb79908b40964185139a0a609aed3032aba064"}),
    ("libstdc++-dev", "14.2.0-r6", {"x86_64": "13e2169b46a24f03c87caf91387312724b01951c222bd061d6d87c48903836a9", "aarch64": "a606b1b4a2cebce71443c3c27876cec4b6d51a5216e362d8674760d6b1586b69"}),
    ("libuv", "1.51.0-r0", {"x86_64": "6cd879561ba6380c5664c221c0de33af177becb0d94a5de0d5d90589a2089737", "aarch64": "730714e5032c7a16c34ac97c778bdd8a770f7927f3b1689616e331599226952c"}),
    ("libxml2", "2.13.9-r1", {"x86_64": "be361698c6f728f492b99550e99e898ae478940fe593d8c11b14c5f3d1b5a938", "aarch64": "e358e1c32ba6923386263dd641a6e4bcb56a0345fecadef9ef1103892cf3d81d"}),
    ("linux-headers", "6.14.2-r0", {"x86_64": "b0d7184f0e8d926961b82dff3d8a6a1f85db100dfc97e3fa1e6a25bbe9fd0f71", "aarch64": "08bc7264055d4ceca249e21f47875ccd7ae2dc7eaf49e235a83b1059e06d9089"}),
    ("llvm20-libs", "20.1.8-r0", {"x86_64": "d0926e20a9e2e65f03f673c1d9d2e69f807e5858920146a0eaedaa68b30fe443", "aarch64": "c4fa059fd8ccd4d35459b05124ef168ddb9837ceb4ccc3b5cdcc2e03c46ae706"}),
    ("lz4-libs", "1.10.0-r0", {"x86_64": "b4f393b9d8ce5a431788b31c899734f84d60a47487a6b833ee8d8012c501fe3f", "aarch64": "0470509674470528eeba694d256066006d628dcab7b77de1be9ba8a186493bab"}),
    ("make", "4.4.1-r3", {"x86_64": "5b66eb4c2db0b0452f1c88d19909397f09e72425d1d9769a480d6370d8a9c310", "aarch64": "5f9be4c947b967b060ea665907b7d0bf159baf78d6972c9e3e617f2061bbe4a7"}),
    ("mpc1", "1.3.1-r1", {"x86_64": "bfc0d8bd7e3b8de2fdfcf4977437281e58147cc568194cb82ba887bd190376e6", "aarch64": "20dca4b0a808aef7d5d9e59eaa1dea59b929f65b103107a1396acab81c2ad278"}),
    ("mpfr4", "4.2.1_p1-r0", {"x86_64": "33f2f274333164dfc25a0002ca58bb99f6d26843d5486c03e3fa207e5432ac59", "aarch64": "258d57fa9c59eee21110a2d3f44a96f893a132e77febb7a5c0abca8512c6fc30"}),
    ("musl", "1.2.5-r12", {"x86_64": "4990a5e0ba312e478f94cfe431a70efef1538004eb361c8ae424516848be45bb", "aarch64": "ac281d1e7f9e9c447c51e309317b975f48be6edaf3ab91ae73b959cf86703782"}),
    ("musl-dev", "1.2.5-r12", {"x86_64": "1c2068d910cfdbbcb4eb107a5a478f8b48edf3a6311953c8fa5180c5190efab3", "aarch64": "576f4aabcfa01d10d6baa2d5d87de436b76e58ae76eedf9db7627051365e1fe3"}),
    ("openssl-dev", "3.5.7-r0", {"x86_64": "e7c16f84972231980b2d6a5ada3f9144da1a57eeea00e8b3119bed68cca5f4f1", "aarch64": "6e7e7b9a8a45ee217b55b1676d4233ecf328f7dc2bd101ece60e1ab2cd399934"}),
    ("pkgconf", "2.4.3-r0", {"x86_64": "32ed811fa76f5f380cda11aa5bdf2f93727760dc4c6d6de5f06dd4c66e3fe3ba", "aarch64": "aac7d6e71d71294cbfefdaaa29ce56eccb758a2d7131861aa6d1bc32ba8e7c57"}),
    ("protobuf", "29.4-r0", {"x86_64": "c578e2bc51a8004e1c3a833027014513615089221d031a991f5e1795bfab5de3", "aarch64": "6a0843d6ff4892ec291715e10849e4a73744785c11c4e3c93b38f1274de9e96a"}),
    ("protoc", "29.4-r0", {"x86_64": "5952b34bdaf52279781e6b2f78d8745ab3f053c81dbe8dd14f9bbc8d11660f5e", "aarch64": "fbe0342b21a7ab51b934b92138632ef79ce8148584e9858441b9e7149176a8e8"}),
    ("rhash-libs", "1.4.5-r0", {"x86_64": "c48bd5cf228e606e961f07a67bf08cfae60136cf93f86f5005678ea7b374bfb9", "aarch64": "85897a8f9d2e519fd7316df2d7e97a6fc1e93741f5d9921ff386a03ef07ae38d"}),
    ("xz-libs", "5.8.3-r0", {"x86_64": "ebb49f0e8efb6ac774d5d8f21a7cf7d63c4658fa36ab1ebaf48ebd67efd60142", "aarch64": "9de7f0fb5f4b6abbe7b7097e94d2787978569c5e143cd144d314e6776382db7c"}),
    ("zlib", "1.3.2-r0", {"x86_64": "1f3d5f463f490dad3a68097376711bfe5e8156e9e8daff3070513aa4378cdeca", "aarch64": "7a39a917e4dab3c7a45537210ee5b5f17bf75f5e7777809a20cddd0afe074187"}),
    ("zstd-libs", "1.5.7-r0", {"x86_64": "1bdd6e57cfbfbfd6e8481cad37ddd5d199950715bec1879b3afb600272dbb09e", "aarch64": "a0e92d2225941a514eb0b2325b137fe6444ef9171627aae8129b74a6ad934ac4"}),
]

def key_of(name):
    return "apk_" + name.replace("-", "_").replace("+", "_").replace(".", "_")

def plugins():
    return {"cargo": imp(fetcher = "cargoplugin", params = {})}

def build():
    # Every "x86_64" in the script below (target triple, ld-musl loader name,
    # rust-std dir) is this same token, so the single .replace() at the end
    # retargets the whole script; only the URLs/sha256s are selected per-arch.
    arch = APK_ARCH[platform]

    toolchain = imp(fetcher = "tarball+https", params = {
        "url": "https://static.rust-lang.org/dist/rust-1.96.0-" + arch + "-unknown-linux-musl.tar.gz",
        "sha256": RUST_SHA[arch],
    })
    musl = imp(fetcher = "hostmusl", params = {}, platform = platform)
    libjuice = imp(fetcher = "github", params = {
        "owner": "paullouisageneau",
        "repo": "libjuice",
        "ref": LIBJUICE_REF,
    })

    inputs = {"toolchain": toolchain, "musl": musl, "libjuice": libjuice}
    stage = []
    for (name, ver, shas) in APKS:
        k = key_of(name)
        inputs[k] = imp(fetcher = "alpineapk", params = {
            "branch": "v3.22", "repo": "main", "arch": arch,
            "name": name, "version": ver, "sha256": shas[arch],
        })
        stage.append('cp -dr "$(jq -r .%s <<<"$JOBS_DEPS")/." /' % k)

    # One vendored-source import per crate in the upstream Cargo.lock.
    crates = plugins["cargo"](cargo_lock = source.read("Cargo.lock"))
    copies = []
    for i, c in enumerate(crates):
        name = "crate_%d" % i
        inputs[name] = c["input"]
        copies.append('ln -s "$(jq -r .%s <<<"$JOBS_DEPS")"/* /build/vendor/' % name)

    script = ("""
set -e
musl="$(jq -r .musl <<<"$JOBS_DEPS")"
toolchain="$(jq -r .toolchain <<<"$JOBS_DEPS")"
juice="$(jq -r .libjuice <<<"$JOBS_DEPS")"

# 1. Stage the Alpine toolchain into the sandbox root: gcc/g++/cmake/make/protoc/
#    libclang run natively at /usr under the staged /lib/ld-musl-x86_64.so.1.
""" + "\n".join(stage) + """

# 2. busybox applets into /bin (cmake/make/build scripts want sh, install, …) and
#    the cc/c++ names the `cc` crate defaults to.
for a in $(/bin/busybox --list); do ln -sf /bin/busybox "/bin/$a"; done
ln -sf /bin/busybox /usr/bin/env
[ -e /usr/bin/cc ] || ln -sf gcc /usr/bin/cc
[ -e /usr/bin/c++ ] || ln -sf g++ /usr/bin/c++
export PATH="/usr/bin:/bin:$PATH"

# 3. Stage the musl-hosted Rust toolchain into the writable /build tree
#    (sequential cp; the combined installer's top dir is versioned, so */
#    matches it). rustc/cargo find ld-musl in /lib and libgcc_s in /usr/lib —
#    both staged from the apks.
mkdir -p /build/rust
cp -dr "$toolchain"/*/rustc/. /build/rust/
cp -dr "$toolchain"/*/cargo/. /build/rust/
cp -dr "$toolchain"/*/rust-std-x86_64-unknown-linux-musl/. /build/rust/
chmod -R u+w /build/rust
export PATH="/build/rust/bin:$PATH"
export CARGO_HOME=/build/cargo

# 4. The libjuice git submodule: github archive tarballs exclude submodules, so
#    it arrives as its own pinned import; build.rs cmake-builds it from the
#    source tree.
mkdir -p "$SRC/wispers-connect/third_party/libjuice"
cp -dr "$juice/." "$SRC/wispers-connect/third_party/libjuice/"

# 5. Vendor dir for cargo's source replacement: a symlink farm into the
#    content-addressed store mounts (each crate input is rooted at
#    <name>-<version>/) — no copying; cargo reads vendored sources through
#    symlinks and never writes to them.
mkdir -p /build/vendor
""" + "\n".join(copies) + """

# 6. Offline cargo config. Alpine gcc is the linker driver (crt files, libstdc++,
#    libssl resolve natively); the interpreter + first RUNPATH entry point at the
#    musl loader's content-addressed store path, the second at $ORIGIN/../lib for
#    the shared libs shipped next to the binaries. This overwrites upstream's
#    .cargo/config.toml, which only carries Android-target rustflags.
mkdir -p "$SRC/.cargo"
cat > "$SRC/.cargo/config.toml" <<EOF
[source.crates-io]
replace-with = "vendored-sources"
[source.vendored-sources]
directory = "/build/vendor"
[build]
rustflags = ["-C", "target-feature=-crt-static", "-C", "linker=/usr/bin/gcc", "-C", "link-arg=-Wl,--dynamic-linker=$musl/lib/ld-musl-x86_64.so.1", "-C", "link-arg=-Wl,-rpath,$musl/lib", "-C", "link-arg=-Wl,-rpath,\\$ORIGIN/../lib"]
EOF

# 7. Native-build env: bindgen -> libclang, prost/tonic -> protoc, openssl-sys ->
#    the staged openssl-dev (skips pkg-config probing). LIBCLANG_PATH points into
#    the llvm20 tree so libclang finds its resource dir (clang/20/include — the
#    builtin headers like stddef.h) next to itself; the /usr/lib copy of
#    libclang.so has no resource dir beside it.
export LIBCLANG_PATH=/usr/lib/llvm20/lib
export PROTOC=/usr/bin/protoc
export OPENSSL_DIR=/usr
# boring-sys `git init`s its OUT_DIR copy of the vendored boringssl purely so
# it *could* `git apply` the rpk/pq/underscore-wildcards feature patches — none
# of which are enabled here. A stub git that accepts `init` (and loudly rejects
# anything else) keeps the stock code path without shipping real git.
# (BORING_BSSL_SOURCE_PATH is NOT usable for this: the vendored tree contains
# src/, which trips boring-sys's is_bazel heuristic and mis-points the
# rustc-link-search at lib/ instead of the cmake build dir.)
cat > /usr/bin/git <<'GITSTUB'
#!/bin/sh
[ "$1" = "init" ] && exit 0
echo "git stub: only 'init' is supported (boring-sys patch machinery would need real git)" >&2
exit 1
GITSTUB
chmod +x /usr/bin/git

# 8. Build the whole workspace offline: wispers-connect (rlib+cdylib), wcadm,
#    wconnect. --frozen = --locked --offline.
cd "$SRC"
cargo build --release --frozen --workspace

# 9. Collect the artifacts + the shared libs the binaries need at run time
#    (resolved via the $ORIGIN/../lib RUNPATH; libgcc_s also lives in the musl
#    runtime_dep's store path).
mkdir -p "$out/bin" "$out/lib" "$out/include"
cp target/release/wcadm target/release/wconnect "$out/bin/"
cp target/release/libwispers_connect.so "$out/lib/"
cp wispers-connect/include/wispers_connect.h "$out/include/"
cp -L /usr/lib/libssl.so.3 /usr/lib/libcrypto.so.3 /usr/lib/libgcc_s.so.1 "$out/lib/"
[ ! -e /usr/lib/libstdc++.so.6 ] || cp -L /usr/lib/libstdc++.so.6 "$out/lib/"

# 10. In-sandbox smoke test: both binaries must load (interpreter from the
#     mounted store, libssl from $out/lib) and print usage.
"$out/bin/wcadm" --help >/dev/null
"$out/bin/wconnect" --help >/dev/null
echo "WISPERS-OK $("$out/bin/wcadm" --version 2>/dev/null || true)"

cat > "$out/JOBS.entrypoint" <<'EOF'
{"command": "bin/wconnect", "args": ["--help"], "env": {}}
EOF
""").replace("x86_64", arch)

    return struct(
        inputs = inputs,
        env = {},
        script = script,
        runtime_deps = [musl],
    )
